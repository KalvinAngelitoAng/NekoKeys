<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRIVACY: no network permission is declared, so Android itself blocks any data from leaving the device.
         The only permission is READ_MEDIA_IMAGES: optional (runtime prompt, off by default), used only to
         preview your newest screenshots in the clipboard panel and to offer the newest one as a pill above the keys. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="NekoKeys"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <service
            android:name=".NekoIME"
            android:exported="true"
            android:label="NekoKeys"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name=".ClipProvider"
            android:authorities="com.nekokeys.keyboard.clips"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".PickerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="NekoKeys">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
